# Local development
LOCAL=True
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Production (cPanel subdomain) — copy and fill in on the server:
# LOCAL=False
# HOSTED_DEBUG=False
# DEBUG=False
# SECRET_KEY=generate-a-long-random-secret
# ALLOWED_HOSTS=clients.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://clients.yourdomain.com
# SECURE_SSL_REDIRECT=True
# USE_PROXY_SSL_HEADER=True
# SERVE_MEDIA=False
# DB_CONN_MAX_AGE=0
# Optional: point at Administration media so school logos resolve.
# MEDIA_ROOT=/home/user/EDUCENTRIC/ADMINISTRATION/media
# MEDIA_URL=/media/
# Copy media/.htaccess to ADMINISTRATION/media when sharing logos.

# Leave DB_NAME blank to use SQLite locally. Set all fields below for MySQL.
DB_NAME=my-school-system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Shared cache / sessions. Required when LOCAL=False (multi-worker production).
# Leave blank for local LocMem + DB sessions.
REDIS_URL=
# Production example:
# REDIS_URL=redis://127.0.0.1:6379/1
