# =============================================================================
# LOCAL development (laptop / XAMPP)
# =============================================================================
LOCAL=True
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave DB_NAME blank to use SQLite. Set all fields below for MySQL.
DB_NAME=my-school-system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Leave blank for local LocMem + DB sessions.
REDIS_URL=

# =============================================================================
# PRODUCTION (cPanel) — copy everything below into .env on the server and fill in
# =============================================================================
# On rs3:
#   nano /home1/projectl/EDUCENTRIC-CLIENTS/.env
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# LOCAL=False
# HOSTED_DEBUG=False
# DEBUG=False
# SECRET_KEY=paste-generated-secret-here
# ALLOWED_HOSTS=clients.projectlucas.co.ke
# CSRF_TRUSTED_ORIGINS=https://clients.projectlucas.co.ke
# SECURE_SSL_REDIRECT=True
# USE_PROXY_SSL_HEADER=True
# SERVE_MEDIA=False
# DB_CONN_MAX_AGE=0
#
# DB_NAME=your_cpanel_db_name
# DB_USER=your_cpanel_db_user
# DB_PASSWORD=your_cpanel_db_password
# DB_HOST=localhost
# DB_PORT=3306
#
# REDIS_URL=redis://127.0.0.1:6379/1
#
# Optional: share Administration logos
# MEDIA_ROOT=/home1/projectl/EDUCENTRIC/ADMINISTRATION/media
# MEDIA_URL=/media/
